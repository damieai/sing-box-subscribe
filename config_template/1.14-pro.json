    {
      "tag": "Others",
      "type": "selector",
      "outbounds": [
        "{all}"
      ],
      "filter": [
        {
          "action": "exclude",
          "keywords": [
            "🇭🇰|HK|hk|香港|港|🇹🇼|TW|tw|台湾|臺灣|🇸🇬|SG|sg|新加坡|狮城|🇯🇵|JP|jp|日本|Japan|🇺🇸|US|us|美国|United States|网站|地址|剩余|过期|时间|有效|官网|建议|流量|到期|套餐|订阅"
          ]
