    {
      "tag": "Auto",
      "type": "urltest",
      "outbounds": [
        "{all}"
      ],
      "filter": [
        {
          "action": "exclude",
          "keywords": [
            "网站|地址|剩余|过期|时间|有效|官网|建议|流量|到期|套餐|订阅"
          ]
        }
      ],
      "url": "http://www.gstatic.com/generate_204",
      "interval": "10m",
      "tolerance": 50
    }
  ],
  "route": {
    "default_domain_resolver": "cn-dns",
    "default_http_client": "default",
    "auto_detect_interface": true,
    "find_process": true,
    "final": "Proxy",
    "rules": [
      {
        "inbound": [
          "tun-in",
          "mixed-in"
        ],
        "action": "sniff"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 53
          },
          {
            "protocol": "dns"
          }
        ],
        "action": "hijack-dns"
      },
      {
        "ip_version": 6,
        "action": "reject"
      },
      {
        "rule_set": [
          "OpenVPN-Endpoint"
        ],
        "action": "route",
        "outbound": "no-fake"
      },
      {
        "action": "resolve",
        "server": "tx-doh",
        "strategy": "ipv4_only",
        "timeout": "5s",
        "domain_suffix": [
          "jurnal.id",
          "mekari.io",
          "mekari"
        ]
      },
      {
        "action": "route",
        "outbound": "Direct",
        "domain_suffix": [
          "jurnal.id",
          "mekari.io",
          "mekari"
        ]
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "Direct"
      },
      {
        "clash_mode": "Direct",
        "action": "route",
        "outbound": "Direct"
      },
      {
        "clash_mode": "Global",
        "action": "route",
        "outbound": "Proxy"
      },
      {
        "rule_set": [
          "AppleCN"
        ],
        "action": "route",
        "outbound": "Direct"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "clash_mode": "AllowAds",
            "invert": true
          },
          {
            "rule_set": [
              "Ads_AWAvenue"
            ]
          }
        ],
        "action": "reject"
      },
      {
        "rule_set": [
          "AI"
        ],
        "action": "route",
        "outbound": "AI"
      },
      {
        "rule_set": [
          "Telegram"
        ],
        "action": "route",
        "outbound": "Telegram"
      },
      {
        "rule_set": [
          "Twitter",
          "Facebook"
        ],
        "action": "route",
        "outbound": "Social"
      },
      {
        "rule_set": [
          "TikTok"
        ],
        "action": "route",
        "outbound": "TikTok"
      },
      {
        "rule_set": [
          "Steam",
          "Epic"
        ],
        "action": "route",
        "outbound": "Game"
      },
      {
        "rule_set": [
          "Google",
          "YouTube",
          "Github"
        ],
        "action": "route",
        "outbound": "Google"
      },
      {
        "rule_set": [
          "Microsoft"
        ],
        "action": "route",
        "outbound": "Microsoft"
      },
      {
        "rule_set": [
          "Emby"
        ],
        "action": "route",
        "outbound": "Emby"
      },
      {
        "rule_set": [
          "Spotify"
        ],
        "action": "route",
        "outbound": "Spotify"
      },
      {
        "rule_set": [
          "Bilibili"
        ],
        "action": "route",
        "outbound": "BiliBili"
      },
      {
        "rule_set": [
          "Bahamut",
          "Netflix",
          "Disney",
          "PrimeVideo",
          "HBO"
        ],
        "action": "route",
        "outbound": "Streaming"
      },
      {
        "rule_set": [
          "ChinaDomain",
          "CN-Domain-Complete"
        ],
        "action": "route",
        "outbound": "Direct"
      },
      {
        "rule_set": [
          "Proxy"
        ],
        "action": "route",
        "outbound": "Proxy"
      },
      {
        "rule_set": [
          "AppleProxy"
        ],
        "action": "route",
        "outbound": "Proxy"
      },
      {
        "action": "resolve",
        "server": "cn-dns",
        "strategy": "ipv4_only",
        "timeout": "5s"
      },
      {
        "rule_set": [
          "ChinaIP",
          "CN-IP-Complete"
        ],
        "action": "route",
        "outbound": "Direct"
      }
    ],
    "rule_set": [
      {
        "type": "inline",
        "tag": "OpenVPN-Endpoint",
        "rules": [
          {
            "process_name": [
              "openvpn.exe",
              "openvpn-gui.exe",
              "openvpnserv.exe",
              "openvpnserv2.exe",
              "OpenVPNConnect.exe",
              "openvpnagent.exe"
            ]
          },
          {
            "ip_cidr": [
              "147.139.192.215/32"
            ]
          }
        ]
      },
      {
        "type": "remote",
        "tag": [
          "Reject",
          "Ads_AWAvenue",
          "Proxy",
          "AI",
          "Telegram",
          "Twitter",
          "Facebook",
          "TikTok",
          "Steam",
          "Epic",
          "Google",
          "YouTube",
          "Github",
          "Microsoft",
          "Bilibili",
          "Bahamut",
          "Emby",
          "Spotify",
          "Netflix",
          "Disney",
          "PrimeVideo",
          "HBO",
          "AppleCN",
          "AppleProxy",
          "ChinaDomain",
          "ChinaIP"
        ],
        "format": "binary",
        "url": "https://raw.githubusercontent.com/Repcz/Tool/X/sing-box/Rules/{tag}.srs",
        "http_client": "default",
        "update_interval": "24h"
      },
      {
        "type": "remote",
        "tag": "CN-Domain-Complete",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/cn.srs",
        "http_client": "default",
        "update_interval": "24h"
